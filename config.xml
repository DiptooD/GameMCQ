<?xml version="1.0" encoding="utf-8"?>
<widget id="com.gamemcq.game" 
        version="1.0.0" 
        android-versionCode="1"
        xmlns="http://www.w3.org/ns/widgets" 
        xmlns:cdv="http://cordova.apache.org/ns/1.0"
        xmlns:android="http://schemas.android.com/apk/res/android">
  
  <name>Game MCQ</name>
  <description>BCS Learning Shooter</description>
  <author email="dipto7744@gmail.com" href="http://yourwebsite.com">Dipto</author>
  
  <content src="index.html" />
  
  <preference name="Orientation" value="portrait" />
  <preference name="Fullscreen" value="true" />
  <preference name="BackgroundColor" value="#000000" />
  <preference name="DisallowOverscroll" value="true" />
  <preference name="KeepRunning" value="true" />

  <plugin name="cordova-plugin-googleplus" spec="^8.5.2">
      <variable name="REVERSED_CLIENT_ID" value="com.googleusercontent.apps.1060690619330-cb5uqvur0e3c6p1290ie61j6n61nkrq7" />
      <variable name="WEB_APPLICATION_CLIENT_ID" value="1060690619330-cb5uqvur0e3c6p1290ie61j6n61nkrq7.apps.googleusercontent.com" />
  </plugin>
  <plugin name="cordova-plugin-x-socialsharing" spec="^6.0.4" />
  <plugin name="cordova-plugin-ionic-keyboard" spec="^2.2.0" />
  
  <preference name="KeyboardResize" value="false" />

  <platform name="android">
    <preference name="android-minSdkVersion" value="24" />
    <preference name="android-targetSdkVersion" value="36" />
    <preference name="android-compileSdkVersion" value="36" />
    <preference name="AndroidXEnabled" value="true" />

    <icon src="icon.png" />
    <splash src="splash.png" />
    
    <preference name="SplashScreen" value="screen" />
    <preference name="AutoHideSplashScreen" value="true" />
    <preference name="ShowSplashScreenSpinner" value="false" />
    <preference name="SplashScreenDelay" value="0" /> 
    <preference name="FadeSplashScreen" value="false" /> 
  </platform>
</widget>